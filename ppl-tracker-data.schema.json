{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gym Tracker app data",
  "description": "Version 4 backup with flexible schedules. Default workouts remain in ppl-default-workouts.json. IDs are unique per collection; schedules must reference available workouts, include a training day, and weekly plans have seven days.",
  "type": "object",
  "properties": {
    "app": {
      "const": "ppl-tracker"
    },
    "version": {
      "const": 4
    },
    "exportedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/body"
      }
    },
    "custom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/custom"
      }
    },
    "drafts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/draft"
      }
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/schedule"
      }
    },
    "calendarEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calendarEvent"
      }
    }
  },
  "required": [
    "app",
    "version",
    "exportedAt",
    "sessions",
    "body",
    "custom",
    "drafts",
    "preferences",
    "schedules"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z0-9_\\-.~:@+]{1,190}$"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "lb"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "set": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number",
          "minimum": 0
        },
        "r": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "working",
            "warmup",
            "drop"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "rir": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "w",
        "r"
      ],
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/set"
          },
          "minItems": 1
        },
        "exerciseId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "name",
        "unit",
        "sets"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "dayId": {
          "$ref": "#/$defs/id"
        },
        "dayName": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "pull",
            "push",
            "legs",
            "other"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exercise"
          },
          "minItems": 1
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "dayId",
        "dayName",
        "type",
        "date",
        "notes",
        "exercises",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "waist": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "date",
        "weight",
        "waist",
        "unit",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "customExercise": {
      "type": "object",
      "properties": {
        "n": {
          "type": "string",
          "minLength": 1
        },
        "s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "lo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "hi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "alt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exerciseId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "n",
        "s",
        "lo",
        "hi",
        "alt"
      ],
      "additionalProperties": false
    },
    "custom": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "pull",
            "push",
            "legs",
            "other"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        },
        "ex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customExercise"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "unit",
        "ex"
      ],
      "additionalProperties": false
    },
    "draftValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "draftSet": {
      "type": "object",
      "properties": {
        "w": {
          "$ref": "#/$defs/draftValue"
        },
        "r": {
          "$ref": "#/$defs/draftValue"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "working",
            "warmup",
            "drop"
          ]
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rir": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "w",
        "r"
      ],
      "additionalProperties": false
    },
    "draftExercise": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftSet"
          },
          "minItems": 1
        },
        "exerciseId": {
          "type": "string"
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 600
        },
        "loadIncrement": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "incrementUnit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "name",
        "unit",
        "sets"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "properties": {
        "sig": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        },
        "ex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftExercise"
          },
          "minItems": 1
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/draftExercise"
          }
        },
        "startedAt": {
          "type": "number",
          "minimum": 0
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 600
        },
        "recoveryWarning": {
          "type": "boolean"
        },
        "restTimer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "durationSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600
                },
                "deadline": {
                  "type": "number"
                },
                "pausedRemainingMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "durationSeconds",
                "deadline",
                "pausedRemainingMs"
              ],
              "additionalProperties": false
            }
          ]
        },
        "workoutTimer": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "idle",
                "running",
                "paused",
                "stopped"
              ]
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0
            },
            "startedAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          },
          "required": [
            "state",
            "elapsedMs",
            "startedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sig",
        "date",
        "notes",
        "ex",
        "extra"
      ],
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "bodyUnit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        },
        "selectedWorkoutId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "progressExercise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeScheduleId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "exerciseDefaults": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?!(__proto__|constructor|prototype)$).+$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "restSeconds": {
                "type": "integer",
                "minimum": 15,
                "maximum": 600
              },
              "loadIncrement": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "incrementUnit": {
                "type": "string",
                "enum": [
                  "kg",
                  "lb"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "progressionEnabled": {
          "type": "boolean"
        },
        "globalRestSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 600
        }
      },
      "required": [
        "bodyUnit",
        "selectedWorkoutId",
        "progressExercise",
        "activeScheduleId"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "type": "string",
          "enum": [
            "cycle",
            "weekly"
          ]
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 28,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "mode",
        "days",
        "cursor"
      ],
      "additionalProperties": false
    },
    "calendarEvent": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "type": {
          "type": "string",
          "enum": [
            "planned",
            "rest",
            "skipped",
            "completed"
          ]
        },
        "workoutId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "date",
        "type",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
